---
import BaseLayout from "../layouts/BaseLayout.astro";
const eventName = "Project Cider";
---
<BaseLayout eventName={eventName}>
	<section>
		<h1>{eventName}</h1>
		<p>An event where all coders unite. A chill coding session where we share our knowledge with one another.</p>
		<p>As the saying goes, take a cider and you'll become a coder</p>
		<p>Coming Soon!</p>
	</section>
</BaseLayout>
