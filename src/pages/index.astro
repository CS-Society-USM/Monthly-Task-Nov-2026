
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Beyond the Possible">
  <section class="relative isolate overflow-hidden grid-background">
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-ink/20 to-ink"
    ></div>

    <div
      class="pointer-events-none absolute top-[12%] right-[-240px] lg:right-[-100px] w-[550px] h-[550px] rounded-full border border-acid/15 glow"
    >
      <div class="absolute inset-[55px] rounded-full border border-acid/15"></div>
      <div class="absolute inset-[120px] rounded-full border border-acid/25"></div>
      <div class="absolute inset-[195px] rounded-full bg-acid/10 blur-3xl"></div>
      <div class="absolute top-[13%] left-[15%] w-3 h-3 rounded-full bg-acid shadow-[0_0_25px_#d4ff5c]"></div>
    </div>

    <div
      class="relative mx-auto max-w-7xl px-6 lg:px-10 pt-20 pb-28 md:pt-28 md:pb-36"
    >
      <div class="reveal inline-flex items-center gap-3 mb-12">
        <span class="h-px w-9 bg-acid"></span>
        <span class="text-acid text-xs font-semibold uppercase tracking-[0.3em]">
          The next generation starts here
        </span>
      </div>

      <div class="reveal reveal-delay relative z-10">
        <p class="text-white/50 text-sm md:text-base tracking-[0.2em] uppercase mb-5">
          Introducing NEXUS 2027
        </p>

        <h1
          class="font-black uppercase tracking-[-0.085em] leading-[0.88] text-[clamp(4.3rem,12vw,11rem)]"
        >
          BEYOND<br />
          <span class="text-outline">THE</span>
          <span class="text-acid"> POSSIBLE.</span>
        </h1>
      </div>

      <div class="mt-12 md:mt-16 grid lg:grid-cols-2 gap-10 items-end">
        <div class="max-w-xl">
          <p class="text-white/65 text-base md:text-lg leading-relaxed">
            An immersive gathering of creators, developers and
            visionaries ready to challenge convention, spark new
            ideas and build what comes next.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-5">
            <a
              href="/about"
              class="group inline-flex items-center gap-8 bg-acid text-ink px-7 py-4 text-xs font-extrabold uppercase tracking-[0.15em] hover:bg-white transition-colors"
            >
              Explore the event
              <span class="text-xl transition-transform group-hover:translate-x-1" aria-hidden="true">↗</span>
            </a>

            <span class="text-white/40 text-xs tracking-widest uppercase">
              Something big is brewing
            </span>
          </div>
        </div>

        <div class="lg:text-right">
          <p class="text-xs uppercase tracking-[0.35em] text-white/40 mb-3">
            Mark the beginning
          </p>
          <p class="text-4xl md:text-6xl font-black tracking-tight">
            20<span class="text-acid">27</span>
          </p>
          <p class="text-white/45 text-sm mt-2">
            The future is closer than you think.
          </p>
        </div>
      </div>

      <div
        class="mt-24 md:mt-32 border-t border-white/15 pt-6 flex flex-col sm:flex-row justify-between gap-5 text-[11px] uppercase tracking-[0.22em] text-white/45"
      >
        <span>01 / A new beginning</span>
        <span>Ideas → Innovation → Impact</span>
        <span>Scroll to discover ↓</span>
      </div>
    </div>
  </section>

  <section class="relative border-y border-white/10 bg-panel">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-24 md:py-32">
      <div class="grid lg:grid-cols-[1fr_1.4fr] gap-12 lg:gap-24">
        <div>
          <p class="text-acid text-xs font-bold uppercase tracking-[0.3em] mb-6">
            / 001 — The vision
          </p>
          <h2 class="text-4xl md:text-6xl font-black tracking-[-0.06em] leading-tight">
            NOT JUST<br />
            ANOTHER<br />
            <span class="text-acid">EVENT.</span>
          </h2>
        </div>

        <div class="flex flex-col justify-center">
          <p class="text-xl md:text-2xl text-white/80 leading-relaxed font-medium">
            What happens when curious minds collide with
            limitless possibilities?
          </p>
          <p class="mt-6 text-white/50 leading-relaxed max-w-xl">
            NEXUS is a space for experimentation, collaboration
            and bold thinking. From breakthrough ideas to
            meaningful connections, we're creating a place
            where the next generation of innovators belongs.
          </p>

          <a
            href="/about"
            class="mt-9 inline-flex items-center gap-3 text-acid text-xs font-bold uppercase tracking-[0.2em] hover:gap-5 transition-all"
          >
            Discover our story <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 opacity-30 grid-background pointer-events-none"
    ></div>

    <div
      class="relative mx-auto max-w-7xl px-6 lg:px-10 py-28 md:py-40 text-center"
    >
      <div class="inline-flex items-center gap-3 text-acid mb-8">
        <span class="h-2 w-2 rounded-full bg-acid animate-pulse"></span>
        <span class="text-xs font-semibold uppercase tracking-[0.3em]">
          Transmission incoming
        </span>
      </div>

      <h2
        class="text-[clamp(3.7rem,10vw,9rem)] leading-[0.95] tracking-[-0.085em] font-black uppercase"
      >
        COMING<br />
        <span class="text-acid">SOON.</span>
      </h2>

      <p class="mt-9 mx-auto max-w-lg text-white/55 leading-relaxed">
        We're putting the pieces together for something extraordinary.
        The next chapter of innovation is almost here.
      </p>

      <div
        class="mt-12 inline-flex items-center gap-4 border border-white/20 px-6 py-4"
      >
        <span class="h-2 w-2 rounded-full bg-acid"></span>
        <span class="text-xs uppercase tracking-[0.2em] text-white/75">
          Stay curious. Stay ready.
        </span>
      </div>

      <p class="mt-16 text-[10px] uppercase tracking-[0.35em] text-white/30">
        NEXUS 2027 / The countdown begins
      </p>
    </div>
  </section>
</BaseLayout>
